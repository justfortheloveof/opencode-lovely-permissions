{
  "name": "opencode-lovely-bash-permissions",
  "version": "0.1.0",
  "description": "Lovely bash permissions for OpenCode",
  "license": "MIT",
  "files": [
    "index.ts",
    "tui.ts",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "vp check",
    "test": "vp test && bun run test:bun",
    "test:bun": "bun test --parallel ./tests-bun",
    "prepare": "vp config --no-agent"
  },
  "dependencies": {
    "@opencode/plugin": "2.1.1",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@opentui/core": "0.6.6",
    "@opentui/solid": "0.6.6",
    "@types/bun": "1.4.3",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "solid-js": "1.9.15",
    "typescript": "^7.0.2",
    "vite-plus": "1.3.0"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.3",
      "onFail": "download"
    }
  },
  "packageManager": "bun@1.4.3"
}
